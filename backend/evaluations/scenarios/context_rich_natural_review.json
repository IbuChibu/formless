{
  "schema_version": 1,
  "suite_id": "context-rich-natural-review-v1",
  "description": "Fixed synthetic conversations for Milestone 9.2.2: natural proposal review, constrained-field ambiguity, compatible option mapping, and deliberate name spelling.",
  "personas": [
    {
      "id": "natural_reviewer",
      "name": "Jordan",
      "summary": "A synthetic user who reviews answers in ordinary spoken language and expects the assistant to understand context.",
      "communication_style": "Short conversational replies, corrections, read-back requests, and occasional ambiguous speech-recognition results.",
      "behaviours": [
        "does not use button labels as commands",
        "expects a pending answer to remain visible until clearly accepted",
        "describes circumstances before knowing the form's official option"
      ]
    }
  ],
  "scenarios": [
    {
      "id": "natural-confirmation",
      "title": "Natural confirmation uses the closed confirmation effect",
      "persona_id": "natural_reviewer",
      "fixture": "sample_form.pdf",
      "field_ids": ["full_name"],
      "purpose": "A clear conversational review decision should confirm exactly the visible pending value.",
      "tags": ["proposal_review", "confirmation_boundary"],
      "turns": [
        {"id": "start", "event": {"type": "advance"}, "expect": {"effects": ["field_selected"], "phase": "awaiting_answer", "field_id": "full_name"}},
        {"id": "answer", "event": {"type": "message", "content": "John Michael"}, "tags": ["latest_answer", "confirmation_boundary"], "expect": {"effects": ["proposal"], "phase": "awaiting_confirmation", "field_id": "full_name", "prepared_value": "John Michael"}},
        {"id": "confirm", "event": {"type": "message", "content": "Yes, that's exactly right."}, "tags": ["context_retention", "confirmation_boundary"], "expect": {"effects": ["confirmed"], "phase": "form_complete", "field_id": "full_name"}}
      ],
      "expected_final": {"confirmed_values": {"full_name": "John Michael"}, "skipped_field_ids": [], "unanswered_field_ids": []},
      "allowed_proposals": {"full_name": ["John Michael"]}
    },
    {
      "id": "natural-rejection",
      "title": "Natural rejection removes only the proposal",
      "persona_id": "natural_reviewer",
      "fixture": "sample_form.pdf",
      "field_ids": ["full_name"],
      "purpose": "A clear rejection should return to answering without changing canonical field state.",
      "tags": ["proposal_review", "recovery"],
      "turns": [
        {"id": "start", "event": {"type": "advance"}, "expect": {"effects": ["field_selected"], "phase": "awaiting_answer", "field_id": "full_name"}},
        {"id": "answer", "event": {"type": "message", "content": "John Michael"}, "tags": ["confirmation_boundary"], "expect": {"effects": ["proposal"], "phase": "awaiting_confirmation", "field_id": "full_name", "prepared_value": "John Michael"}},
        {"id": "reject", "event": {"type": "message", "content": "No, that's wrong."}, "tags": ["recovery", "confirmation_boundary"], "expect": {"effects": ["rejected"], "phase": "awaiting_answer", "field_id": "full_name"}}
      ],
      "expected_final": {"confirmed_values": {}, "skipped_field_ids": [], "unanswered_field_ids": ["full_name"]},
      "allowed_proposals": {"full_name": ["John Michael"]}
    },
    {
      "id": "read-back-keeps-review",
      "title": "Read-back request preserves the pending proposal",
      "persona_id": "natural_reviewer",
      "fixture": "sample_form.pdf",
      "field_ids": ["full_name"],
      "purpose": "Asking to hear an answer again should be conversational and must not confirm or reject it.",
      "tags": ["proposal_review", "context_retention"],
      "turns": [
        {"id": "start", "event": {"type": "advance"}, "expect": {"effects": ["field_selected"], "phase": "awaiting_answer", "field_id": "full_name"}},
        {"id": "answer", "event": {"type": "message", "content": "John Michael"}, "tags": ["confirmation_boundary"], "expect": {"effects": ["proposal"], "phase": "awaiting_confirmation", "field_id": "full_name", "prepared_value": "John Michael"}},
        {"id": "repeat", "event": {"type": "message", "content": "Could you read that back?"}, "tags": ["context_retention", "confirmation_boundary"], "expect": {"effects": ["none"], "phase": "awaiting_confirmation", "field_id": "full_name", "state_unchanged": true}}
      ],
      "expected_final": {"confirmed_values": {}, "skipped_field_ids": [], "unanswered_field_ids": ["full_name"]},
      "allowed_proposals": {"full_name": ["John Michael"]}
    },
    {
      "id": "near-match-permit-does-not-confirm",
      "title": "Speech near-match cannot confirm",
      "persona_id": "natural_reviewer",
      "fixture": "sample_form.pdf",
      "field_ids": ["full_name"],
