        {"id": "near-match", "event": {"type": "message", "content": "Permit."}, "tags": ["clarification", "confirmation_boundary"], "expect": {"effects": ["none"], "phase": "awaiting_confirmation", "field_id": "full_name", "state_unchanged": true}}
      ],
      "expected_final": {"confirmed_values": {}, "skipped_field_ids": [], "unanswered_field_ids": ["full_name"]},
      "allowed_proposals": {"full_name": ["John Michael"]}
